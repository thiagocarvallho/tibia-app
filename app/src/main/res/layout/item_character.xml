<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="0dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="#f5e6c8"> <!-- cor tipo pergaminho -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:orientation="vertical"> <!-- textura medieval -->

        <!-- Nome em destaque -->
        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nome: "
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#5e2a00"
            android:fontFamily="serif" />

        <!-- Sub-informações agrupadas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/tvLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Level: "
                android:textSize="16sp"
                android:textColor="#3d1f00"
                android:layout_marginEnd="16dp"
                android:fontFamily="serif"/>

            <TextView
                android:id="@+id/tvVocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vocação: "
                android:textSize="16sp"
                android:textColor="#3d1f00"
                android:fontFamily="serif"/>
        </LinearLayout>

        <!-- Separador medieval -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#8b5a2b"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"/>

        <!-- Mundo -->
        <TextView
            android:id="@+id/tvWorld"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mundo: "
            android:textSize="16sp"
            android:textColor="#b8860b"
            android:textStyle="bold"
            android:fontFamily="serif" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
