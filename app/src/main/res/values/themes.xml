<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Tibia" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/tibia_primary</item>
        <item name="colorPrimaryVariant">@color/tibia_primary_dark</item>
        <item name="colorOnPrimary">@color/tibia_text</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/tibia_primary</item>
        <item name="colorSecondaryVariant">@color/tibia_primary_dark</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>
    <style name="Theme.Tibia.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
    <style name="Theme.Tibia.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="Theme.Tibia.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>